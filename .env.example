# Server
NODE_ENV=production
PORT=5001
APP_BASE_URL=https://your-app.example.com
PUBLIC_BASE_URL=https://your-app.example.com
JWT_SECRET=generate-with-openssl-rand-base64-48
INTEGRATION_ENCRYPTION_KEY=generate-with-openssl-rand-base64-48
PUBLIC_ASSET_SIGNING_SECRET=generate-with-openssl-rand-base64-48
DATABASE_PATH=./data/standalone-blog-writer.db

# Company / tenancy
DEFAULT_COMPANY_ID=demo-company
BLOG_SEED_IBOLT_DEMO=false
ENABLE_LEGACY_SCHOLARMARK=false
VITE_ENABLE_LEGACY_SCHOLARMARK=false
IBOLT_BLOG_ALLOW_UNAUTHENTICATED=false
BLOG_ALLOW_UNVALIDATED_COMPANY_SELECTION=false
IBOLT_INTERNAL_AUTH_BYPASS=false
BLOG_ALLOW_UNSIGNED_PUBLIC_PHOTOS=false
ALLOW_IBOLT_DEMO_SCRIPTS=false
ALLOW_CHROME_EXTENSION_ORIGINS=false
BLOG_ALLOW_LOCAL_PHOTO_IMPORTS=false
BLOG_ALLOW_LOCAL_FILE_IMPORTS=false
BLOG_LOCAL_IMPORT_DIR=/app/data/imports
BLOG_ALLOW_LEGACY_CONTENT_IMPORT=false

# Auth
CLERK_PUBLISHABLE_KEY=pk_live_your-live-clerk-publishable-key
CLERK_SECRET_KEY=sk_live_your-live-clerk-secret-key
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your-live-clerk-publishable-key

# AI providers
ANTHROPIC_API_KEY=
# Required for Asset Bank vision analysis. Blog generation can use Anthropic or OpenAI.
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# Blog generation models
BLOG_ANTHROPIC_MODEL=claude-sonnet-4-6
BLOG_OPENAI_MODEL=gpt-4.1-mini
BLOG_QUALITY_GATE=70

# AI visibility benchmark models
AI_BENCHMARK_OPENAI_MODEL=gpt-4.1
AI_BENCHMARK_ANTHROPIC_MODEL=claude-sonnet-4-6
AI_BENCHMARK_GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
AI_BENCHMARK_FORCE_OPENROUTER=false
AI_BENCHMARK_OPENROUTER_CHATGPT_MODEL=openai/gpt-4o
AI_BENCHMARK_OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-4
AI_BENCHMARK_OPENROUTER_GEMINI_MODEL=google/gemini-2.5-flash

# Local customer discovery
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Shopify publishing
# Store per-company integrations through OAuth. Manual token refs are not
# accepted from tenant-facing company settings.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-real-shopify-app-client-id
SHOPIFY_CLIENT_SECRET=your-real-shopify-app-client-secret
SHOPIFY_API_VERSION=2026-04
SHOPIFY_OAUTH_SCOPES=read_products,read_content,write_content
SHOPIFY_BLOG_HANDLES={"104843772196":"news"}
BLOG_ALLOW_SHOPIFY_COLLECTION_MUTATION=false
