    {
      "@type": "HowTo",
      "@id": "https://iboltmounts.com/pages/forklift-tablet-mounting-solutions#howto",
      "name": "How to choose a forklift tablet mount",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Identify the device: tablet, scanner, monitor, or paired tablet and barcode scanner."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Choose a pillar, overhead guard, magnetic, or VESA mounting location that does not block operator visibility."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Use a heavier ball size, such as 38mm, when the device is large or exposed to vibration."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Add locking hardware when tablets stay on shared equipment between shifts."
        }
      ]
    }
