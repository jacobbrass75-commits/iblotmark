    {
      "@type": "HowTo",
      "@id": "https://iboltmounts.com/pages/fleet-eld-mounting-systems#howto",
      "name": "How to standardize fleet and ELD mounts",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "List the tablets, phones, ELD devices, scanners, and chargers used in each vehicle class."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Choose approved mount positions that keep screens readable without blocking visibility or controls."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Standardize the base type by vehicle group, such as suction, seat rail, drill base, or AMPS."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Document the parts list so replacements and new vehicle installs use the same hardware."
        }
      ]
