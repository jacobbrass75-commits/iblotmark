    {
      "@type": "HowTo",
      "@id": "https://iboltmounts.com/pages/restaurant-tablet-mounts-multi-tablet-delivery-stations#howto",
      "name": "How to build a multi-tablet restaurant delivery station",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Count every POS, delivery, ordering, and kitchen-display tablet that needs to stay visible during a rush."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Decide whether the station should clamp to a counter, mount to a wall, or use a weighted POS base."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Choose a 3, 4, or 5 holder Tablet Tower based on current platforms plus one open position for growth."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Route charging cables behind the station so staff can read every screen without cords crossing prep space."
        }
      ]
