    {
      "@type": "HowTo",
      "@id": "https://iboltmounts.com/pages/amps-mounting-system-amps-mounting-plates#howto",
      "name": "How to choose an AMPS mounting plate",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Confirm whether the device uses the 4-hole AMPS pattern, VESA 75/100, 1/4-20 camera thread, or a ball mount."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Choose an AMPS plate or adapter that matches the device side of the connection."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Match the plate to a base style: drill base, clamp base, suction, magnetic, wall, or vehicle mount."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Use the correct ball size for the device weight, with 25mm for many tablets and 38mm for heavier commercial setups."
        }
      ]
    }
